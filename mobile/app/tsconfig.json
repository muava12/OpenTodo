{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "types": ["jest", "node"],
    "paths": {
      "@shared/*": ["../../web/src/lib/*"],
      "@legendapp/list": ["./node_modules/@legendapp/list/react-native.d.ts"]
    }
  },
  "include": ["index.ts", "app.config.ts", "src", "test", "perf"]
}
